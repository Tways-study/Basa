# Names only. Copy to .env.local and fill in values; never commit .env.local.
META_API_KEY=
# Base URL only: https://api.meta.ai/v1 (no trailing slash or period). Paths are added in code.
META_API_BASE_URL=
META_SPARK_MODEL=
META_SAM_MODEL=
BASETEN_API_KEY=
# The full chat-completions endpoint, not just the base URL.
BASETEN_MODEL_URL=
# Model name sent to Baseten. Target: meta-models/muse-spark-open-1026 (needs hackathon credits). Without them: meta-models/muse-spark-open.
BASETEN_MODEL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAX_MODEL_CALLS_PER_SCAN=
MOCK_MODELS=
